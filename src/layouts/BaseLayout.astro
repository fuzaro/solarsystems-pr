---
import Nav from '../components/Nav.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';

interface Props {
  title?: string;
  lang?: string;
  currentPage?: string;
}

const { title = 'Solar Systems AI', lang = 'en', currentPage = '' } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Top navigation -->
    <Nav lang={lang} currentPage={currentPage}>
      <LanguageSwitcher slot="lang-switcher" lang={lang} />
    </Nav>

    <!-- Main content area: sidebar + page -->
    <div class="flex flex-1 overflow-hidden">
      <!-- Sidebar -->
      <Sidebar lang={lang} currentPage={currentPage} />

      <!-- Page content -->
      <div class="flex-1 flex flex-col overflow-auto">
        <main class="flex-1 p-6 lg:p-8">
          <slot />
        </main>

        <!-- Footer -->
        <Footer lang={lang} />
      </div>
    </div>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
