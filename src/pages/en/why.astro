---
import BaseLayout from '../../layouts/BaseLayout.astro';
import en from '../../i18n/en.json';
---
<BaseLayout title="Solar Systems AI — Why" lang="en" currentPage="why">
  <section class="max-w-4xl mx-auto">
    <!-- Headline -->
    <div class="mb-10">
      <h1 class="font-display text-2xl font-bold tracking-widest text-theme-accent mb-2">◇ {en.why.headline}</h1>
      <p class="font-sans text-sm text-theme-muted">An investor thesis on time, attention, and infrastructure.</p>
    </div>

    <!-- The Problem -->
    <div class="mb-10">
      <h2 class="font-display text-xs tracking-[0.2em] text-theme-accent-2 font-bold mb-3">◆ {en.why.problem_title}</h2>
      <p class="font-sans text-sm text-theme-text leading-relaxed max-w-2xl">
        {en.why.problem_text}
      </p>
    </div>

    <!-- The Insight -->
    <div class="mb-10">
      <h2 class="font-display text-xs tracking-[0.2em] text-theme-accent font-bold mb-3">◆ {en.why.insight_title}</h2>
      <p class="font-sans text-sm text-theme-text leading-relaxed max-w-2xl">
        {en.why.insight_text}
      </p>
    </div>

    <!-- Our Answer -->
    <div class="mb-12">
      <h2 class="font-display text-xs tracking-[0.2em] text-theme-success font-bold mb-3">◆ {en.why.answer_title}</h2>
      <p class="font-sans text-sm text-theme-text leading-relaxed max-w-2xl">
        {en.why.answer_text}
      </p>
    </div>

    <!-- Key Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-theme-surface rounded shadow-sm px-5 py-5 border-l-4 border-theme-card-1">
        <div class="font-mono text-2xl text-theme-text font-bold mb-1">9</div>
        <div class="font-sans text-xs text-theme-muted">{en.why.stat_subsystems}</div>
      </div>
      <div class="bg-theme-surface rounded shadow-sm px-5 py-5 border-l-4 border-theme-card-2">
        <div class="font-mono text-2xl text-theme-text font-bold mb-1">7</div>
        <div class="font-sans text-xs text-theme-muted">{en.why.stat_lifecycle}</div>
      </div>
      <div class="bg-theme-surface rounded shadow-sm px-5 py-5 border-l-4 border-theme-card-3">
        <div class="font-mono text-2xl text-theme-text font-bold mb-1">6</div>
        <div class="font-sans text-xs text-theme-muted">{en.why.stat_principles}</div>
      </div>
      <div class="bg-theme-surface rounded shadow-sm px-5 py-5 border-l-4 border-theme-success">
        <div class="font-mono text-2xl text-theme-text font-bold mb-1">0</div>
        <div class="font-sans text-xs text-theme-muted">{en.why.stat_audits}</div>
      </div>
    </div>
  </section>
</BaseLayout>
