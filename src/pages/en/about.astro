---
import BaseLayout from '../../layouts/BaseLayout.astro';
import en from '../../i18n/en.json';
---
<BaseLayout title="Solar Systems AI — About" lang="en" currentPage="about">
  <section class="max-w-4xl mx-auto">
    <!-- Headline -->
    <div class="mb-10">
      <h1 class="font-display text-2xl font-bold tracking-widest text-theme-accent mb-2">◇ {en.about.headline}</h1>
    </div>

    <!-- Positioning -->
    <div class="mb-10">
      <h2 class="font-display text-xs tracking-[0.2em] text-theme-text font-bold mb-3">◆ POSITIONING</h2>
      <p class="font-sans text-sm text-theme-text leading-relaxed max-w-2xl">
        {en.about.positioning}
      </p>
    </div>

    <!-- Approach -->
    <div class="mb-10">
      <h2 class="font-display text-xs tracking-[0.2em] text-theme-text font-bold mb-3">◆ APPROACH</h2>
      <p class="font-sans text-sm text-theme-text leading-relaxed max-w-2xl">
        {en.about.approach}
      </p>
    </div>

    <!-- Differentiation -->
    <div class="mb-10">
      <h2 class="font-display text-xs tracking-[0.2em] text-theme-text font-bold mb-3">◆ {en.about.diff_title}</h2>
      <p class="font-sans text-sm text-theme-muted max-w-2xl mb-5">{en.about.diff_intro}</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
        {en.about.diff_columns.map((col, i) => (
          <div class:list={['bg-theme-surface rounded shadow-sm px-5 py-5 border-t-4', i === 2 ? 'border-theme-accent' : 'border-theme-border']}>
            <div class="font-mono text-xs text-theme-accent font-bold tracking-wider mb-1">{col.name}</div>
            <div class="font-mono text-[10px] text-theme-muted tracking-wider mb-3">{col.focus}</div>
            <p class="font-sans text-xs text-theme-muted leading-relaxed">{col.text}</p>
          </div>
        ))}
      </div>
      <div class="bg-theme-terminal rounded px-5 py-4">
        <p class="font-mono text-xs text-theme-muted leading-relaxed">{en.about.diff_close}</p>
      </div>
    </div>

    <!-- Team -->
    <div class="bg-theme-terminal rounded-lg px-6 py-8 text-center">
      <div class="font-mono text-xs tracking-[0.2em] text-theme-muted mb-3">◆ PERSONNEL_RECORD</div>
      <div class="font-mono text-xl text-theme-nav-text tracking-wider">{en.about.team}</div>
    </div>
  </section>
</BaseLayout>
