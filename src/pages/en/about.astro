---
import BaseLayout from '../../layouts/BaseLayout.astro';
import en from '../../i18n/en.json';
---
<BaseLayout title="Solar Systems AI — About" lang="en" currentPage="about">
  <section class="max-w-4xl mx-auto">
    <!-- Headline -->
    <div class="mb-10">
      <h1 class="font-mono text-2xl font-bold tracking-widest text-blue-terminal mb-2">◇ {en.about.headline}</h1>
    </div>

    <!-- Positioning -->
    <div class="mb-10">
      <h2 class="font-mono text-xs tracking-[0.2em] text-navy-dark font-bold mb-3">◆ POSITIONING</h2>
      <p class="font-sans text-sm text-gray-700 leading-relaxed max-w-2xl">
        {en.about.positioning}
      </p>
    </div>

    <!-- Approach -->
    <div class="mb-10">
      <h2 class="font-mono text-xs tracking-[0.2em] text-navy-dark font-bold mb-3">◆ APPROACH</h2>
      <p class="font-sans text-sm text-gray-700 leading-relaxed max-w-2xl">
        {en.about.approach}
      </p>
    </div>

    <!-- Team -->
    <div class="bg-navy-dark rounded-lg px-6 py-8 text-center">
      <div class="font-mono text-xs tracking-[0.2em] text-gray-400 mb-3">◆ PERSONNEL_RECORD</div>
      <div class="font-mono text-xl text-white tracking-wider">{en.about.team}</div>
    </div>
  </section>
</BaseLayout>
