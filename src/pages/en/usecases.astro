---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlanetCard from '../../components/PlanetCard.astro';
import en from '../../i18n/en.json';
---
<BaseLayout title="Solar Systems AI — Use Cases" lang="en" currentPage="usecases">
  <section class="max-w-5xl mx-auto">
    <!-- Headline -->
    <div class="mb-10">
      <h1 class="font-display text-2xl font-bold tracking-widest text-theme-accent mb-2">◇ {en.usecases.headline}</h1>
      <p class="font-sans text-sm text-theme-muted">{en.usecases.subtitle}</p>
    </div>

    <!-- Horizontal cases -->
    <div class="mb-12">
      <h2 class="font-display text-xs tracking-[0.2em] text-theme-text font-bold mb-6">◆ {en.usecases.cases_title}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {en.usecases.cases.map((c) => (
          <PlanetCard title={c.title} icon={c.icon} variant={c.variant}>
            <div class="px-4 pb-4">
              <p class="text-xs text-theme-muted font-sans leading-relaxed">{c.text}</p>
            </div>
          </PlanetCard>
        ))}
      </div>
    </div>

    <!-- Verticals -->
    <div class="mb-8">
      <h2 class="font-display text-xs tracking-[0.2em] text-theme-text font-bold mb-3">◆ {en.usecases.verticals_title}</h2>
      <p class="font-sans text-sm text-theme-muted max-w-2xl mb-6">{en.usecases.verticals_intro}</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {en.usecases.verticals.map((v) => (
          <div class="bg-theme-surface rounded shadow-sm px-5 py-5 border-t-4 border-theme-accent">
            <div class="flex items-baseline gap-3 mb-4">
              <span class="font-mono text-lg text-theme-accent">{v.icon}</span>
              <span class="font-mono text-sm text-theme-accent font-bold tracking-wider">{v.name}</span>
            </div>
            <ul class="space-y-2">
              {v.items.map((item) => (
                <li class="flex gap-2 font-sans text-xs text-theme-muted leading-relaxed">
                  <span class="text-theme-accent-2 shrink-0">▸</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <!-- Deployment note -->
    <div class="bg-theme-terminal rounded px-5 py-4">
      <p class="font-mono text-xs text-theme-nav-text leading-relaxed" style="opacity:0.8">{en.usecases.note}</p>
    </div>
  </section>
</BaseLayout>
