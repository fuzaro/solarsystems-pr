---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlanetCard from '../../components/PlanetCard.astro';
import TerminalFeed from '../../components/TerminalFeed.astro';
import en from '../../i18n/en.json';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;
const hrefHow = `${base}/en/how`;
const hrefPrinciples = `${base}/en/principles`;
---
<BaseLayout title="Solar Systems AI — Home" lang="en" currentPage="home">
  <section class="max-w-5xl mx-auto">
    <div class="mb-8">
      <!-- Status badge -->
      <div class="inline-flex items-center gap-2 bg-theme-nav text-theme-success font-mono text-[10px] tracking-[0.2em] px-3 py-1.5 rounded mb-4">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-theme-success animate-pulse"></span>
        {en.home.badge}
      </div>

      <!-- Main heading -->
      <h1 class="font-display text-4xl lg:text-5xl tracking-[0.15em] text-theme-text font-bold leading-tight mb-3">
        {en.home.title}<br/>
        <span class="text-theme-accent">{en.home.subtitle}</span>
      </h1>

      <!-- Subtitle -->
      <p class="font-sans text-sm text-theme-muted max-w-lg leading-relaxed mb-6">
        {en.home.description}
      </p>

      <!-- CTA buttons -->
      <div class="flex flex-wrap gap-3">
        <a href={hrefHow} class="inline-flex items-center gap-2 bg-theme-accent text-theme-nav-text font-mono text-xs tracking-[0.2em] px-5 py-2.5 rounded hover:opacity-90 transition-opacity">
          ◆ {en.home.cta_primary}
        </a>
        <a href={hrefPrinciples} class="inline-flex items-center gap-2 bg-theme-surface text-theme-text font-mono text-xs tracking-[0.2em] px-5 py-2.5 rounded border border-theme-border hover:border-theme-accent hover:text-theme-accent transition-colors">
          ◇ {en.home.cta_secondary}
        </a>
      </div>
    </div>

    <!-- Planet Cards Row -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
      <PlanetCard
        title="ENTRY_POINT"
        name="VENUS"
        status="ACTIVE"
        icon="♀"
        variant="gold"
      />
      <PlanetCard
        title="SECURITY_AUTHORITY"
        name="PLUTO"
        status="ACTIVE"
        icon="♇"
        variant="orange"
      />
      <PlanetCard
        title="MEMORY_AND_AUDIT"
        name="MOON"
        status="ACTIVE"
        icon="☾"
        variant="blue"
      />
    </div>

    <!-- Terminal Feed -->
    <div class="max-w-2xl">
      <TerminalFeed lines={en.home.feed_lines} title={en.home.feed_title} />
    </div>
  </section>
</BaseLayout>
