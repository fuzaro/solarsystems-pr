---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TimelineEntry from '../../components/TimelineEntry.astro';
import pt from '../../i18n/pt.json';
---
<BaseLayout title="Solar Systems AI — Status" lang="pt" currentPage="status">
  <section class="max-w-4xl mx-auto">
    <!-- Headline -->
    <div class="mb-10">
      <h1 class="font-display text-2xl font-bold tracking-widest text-theme-accent mb-2">◇ {pt.status.headline}</h1>
      <p class="font-sans text-sm text-theme-muted">{pt.status.subtitle}</p>
    </div>

    <!-- Terminal-style timeline -->
    <div class="bg-theme-terminal rounded-lg overflow-hidden shadow-md mb-8">
      <!-- Title bar -->
      <div class="flex items-center gap-3 px-4 py-2 bg-theme-terminal border-b border-theme-border">
        <span class="w-2.5 h-2.5 rounded-full bg-theme-success shrink-0"></span>
        <span class="text-[10px] text-theme-muted tracking-[0.2em] font-bold font-mono">REGISTRO_OPERACIONAL</span>
      </div>
      <!-- Feed body -->
      <div class="px-4 py-3 space-y-1">
        {pt.status.milestones.map((m) => (
          <TimelineEntry timestamp={m.timestamp} level={m.level} message={m.message} />
        ))}
      </div>
    </div>

    <!-- System Status Summary -->
    <div class="bg-theme-surface rounded shadow-sm px-5 py-4 border border-theme-border">
      <div class="flex items-center gap-3">
        <span class="inline-block w-2 h-2 rounded-full bg-theme-accent"></span>
        <span class="font-mono text-xs tracking-wider text-theme-text font-bold">{pt.status.system_status}</span>
      </div>
    </div>
  </section>
</BaseLayout>
