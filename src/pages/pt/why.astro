---
import BaseLayout from '../../layouts/BaseLayout.astro';
import pt from '../../i18n/pt.json';
---
<BaseLayout title="Solar Systems AI — Por Que" lang="pt" currentPage="why">
  <section class="max-w-4xl mx-auto">
    <!-- Headline -->
    <div class="mb-10">
      <h1 class="font-display text-2xl font-bold tracking-widest text-theme-accent mb-2">◇ {pt.why.headline}</h1>
      <p class="font-sans text-sm text-theme-muted">Uma tese de investimento sobre tempo, atenção e infraestrutura.</p>
    </div>

    <!-- The Problem -->
    <div class="mb-10">
      <h2 class="font-display text-xs tracking-[0.2em] text-theme-accent-2 font-bold mb-3">◆ {pt.why.problem_title}</h2>
      <p class="font-sans text-sm text-theme-text leading-relaxed max-w-2xl">
        {pt.why.problem_text}
      </p>
    </div>

    <!-- The Insight -->
    <div class="mb-10">
      <h2 class="font-display text-xs tracking-[0.2em] text-theme-accent font-bold mb-3">◆ {pt.why.insight_title}</h2>
      <p class="font-sans text-sm text-theme-text leading-relaxed max-w-2xl">
        {pt.why.insight_text}
      </p>
    </div>

    <!-- The Enterprise Gap -->
    <div class="mb-10">
      <h2 class="font-display text-xs tracking-[0.2em] text-theme-accent-2 font-bold mb-3">◆ {pt.why.enterprise_title}</h2>
      <p class="font-sans text-sm text-theme-text leading-relaxed max-w-2xl mb-5">
        {pt.why.enterprise_text}
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-5">
        {pt.why.enterprise_gaps.map((gap, i) => (
          <div class="bg-theme-surface rounded shadow-sm px-5 py-4 border-l-4 border-theme-accent-2">
            <div class="font-mono text-[10px] text-theme-muted mb-1">{String(i + 1).padStart(2, '0')}</div>
            <div class="font-mono text-xs text-theme-accent-2 font-bold tracking-wider mb-2">{gap.title}</div>
            <p class="font-sans text-xs text-theme-muted leading-relaxed">{gap.text}</p>
          </div>
        ))}
      </div>
      <div class="bg-theme-terminal rounded px-5 py-4">
        <div class="font-mono text-xs text-theme-accent font-bold tracking-wider mb-2">{pt.why.valley_title}</div>
        <p class="font-mono text-xs text-theme-nav-text leading-relaxed" style="opacity:0.8">{pt.why.valley_text}</p>
      </div>
    </div>

    <!-- Our Answer -->
    <div class="mb-12">
      <h2 class="font-display text-xs tracking-[0.2em] text-theme-success font-bold mb-3">◆ {pt.why.answer_title}</h2>
      <p class="font-sans text-sm text-theme-text leading-relaxed max-w-2xl">
        {pt.why.answer_text}
      </p>
    </div>

    <!-- Key Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-theme-surface rounded shadow-sm px-5 py-5 border-l-4 border-theme-card-1">
        <div class="font-mono text-2xl text-theme-text font-bold mb-1">11</div>
        <div class="font-sans text-xs text-theme-muted">{pt.why.stat_subsystems}</div>
      </div>
      <div class="bg-theme-surface rounded shadow-sm px-5 py-5 border-l-4 border-theme-card-2">
        <div class="font-mono text-2xl text-theme-text font-bold mb-1">7</div>
        <div class="font-sans text-xs text-theme-muted">{pt.why.stat_lifecycle}</div>
      </div>
      <div class="bg-theme-surface rounded shadow-sm px-5 py-5 border-l-4 border-theme-card-3">
        <div class="font-mono text-2xl text-theme-text font-bold mb-1">6</div>
        <div class="font-sans text-xs text-theme-muted">{pt.why.stat_principles}</div>
      </div>
      <div class="bg-theme-surface rounded shadow-sm px-5 py-5 border-l-4 border-theme-success">
        <div class="font-mono text-2xl text-theme-text font-bold mb-1">v2</div>
        <div class="font-sans text-xs text-theme-muted">{pt.why.stat_audits}</div>
      </div>
    </div>
  </section>
</BaseLayout>
