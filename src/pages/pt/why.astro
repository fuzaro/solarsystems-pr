---
import BaseLayout from '../../layouts/BaseLayout.astro';
import pt from '../../i18n/pt.json';
---
<BaseLayout title="Solar Systems AI — Por Que" lang="pt" currentPage="why">
  <section class="max-w-4xl mx-auto">
    <!-- Headline -->
    <div class="mb-10">
      <h1 class="font-mono text-2xl font-bold tracking-widest text-blue-terminal mb-2">◇ {pt.why.headline}</h1>
      <p class="font-sans text-sm text-gray-500">Uma tese de investimento sobre tempo, atenção e infraestrutura.</p>
    </div>

    <!-- The Problem -->
    <div class="mb-10">
      <h2 class="font-mono text-xs tracking-[0.2em] text-orange-alert font-bold mb-3">◆ {pt.why.problem_title}</h2>
      <p class="font-sans text-sm text-gray-700 leading-relaxed max-w-2xl">
        {pt.why.problem_text}
      </p>
    </div>

    <!-- The Insight -->
    <div class="mb-10">
      <h2 class="font-mono text-xs tracking-[0.2em] text-blue-terminal font-bold mb-3">◆ {pt.why.insight_title}</h2>
      <p class="font-sans text-sm text-gray-700 leading-relaxed max-w-2xl">
        {pt.why.insight_text}
      </p>
    </div>

    <!-- Our Answer -->
    <div class="mb-12">
      <h2 class="font-mono text-xs tracking-[0.2em] text-green-600 font-bold mb-3">◆ {pt.why.answer_title}</h2>
      <p class="font-sans text-sm text-gray-700 leading-relaxed max-w-2xl">
        {pt.why.answer_text}
      </p>
    </div>

    <!-- Key Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-white rounded shadow-sm px-5 py-5 border-l-4 border-orange-alert">
        <div class="font-mono text-2xl text-navy-dark font-bold mb-1">9</div>
        <div class="font-sans text-xs text-gray-600">{pt.why.stat_subsystems}</div>
      </div>
      <div class="bg-white rounded shadow-sm px-5 py-5 border-l-4 border-blue-terminal">
        <div class="font-mono text-2xl text-navy-dark font-bold mb-1">7</div>
        <div class="font-sans text-xs text-gray-600">{pt.why.stat_lifecycle}</div>
      </div>
      <div class="bg-white rounded shadow-sm px-5 py-5 border-l-4 border-gold-warning">
        <div class="font-mono text-2xl text-navy-dark font-bold mb-1">6</div>
        <div class="font-sans text-xs text-gray-600">{pt.why.stat_principles}</div>
      </div>
      <div class="bg-white rounded shadow-sm px-5 py-5 border-l-4 border-green-600">
        <div class="font-mono text-2xl text-navy-dark font-bold mb-1">0</div>
        <div class="font-sans text-xs text-gray-600">{pt.why.stat_audits}</div>
      </div>
    </div>
  </section>
</BaseLayout>
