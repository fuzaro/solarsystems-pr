---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlanetCard from '../../components/PlanetCard.astro';
import SchematicDiagram from '../../components/SchematicDiagram.astro';
import pt from '../../i18n/pt.json';

const [execTag, ...execRest] = pt.how.execution_note.split(' — ');
const execBody = execRest.join(' — ');
---
<BaseLayout title="Solar Systems AI — Como Funciona" lang="pt" currentPage="how">
  <section class="max-w-5xl mx-auto">
    <!-- Headline -->
    <div class="mb-10">
      <h1 class="font-display text-2xl font-bold tracking-widest text-theme-accent mb-2">◇ {pt.how.headline}</h1>
      <p class="font-sans text-sm text-theme-muted">Da solicitação ao resultado. Cada etapa contabilizada.</p>
    </div>

    <!-- 7-Step Lifecycle -->
    <div class="mb-12">
      <h2 class="font-display text-xs tracking-[0.2em] text-theme-text font-bold mb-6">◆ {pt.how.lifecycle_title}</h2>
      <div class="space-y-0">
        {pt.how.lifecycle_steps.map((step, index) => (
          <div class="flex items-start gap-4 bg-theme-surface rounded shadow-sm px-5 py-4 mb-3">
            <div class="shrink-0">
              <div class="w-10 h-10 rounded-full bg-theme-nav flex items-center justify-center text-theme-nav-text font-mono text-xs font-bold">
                {step.number}
              </div>
            </div>
            <div>
              <div class="font-mono text-sm text-theme-accent font-bold tracking-wider mb-1">{step.name}</div>
              <p class="font-sans text-sm text-theme-muted">{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Governed path -->
    <div class="mb-12">
      <h2 class="font-display text-xs tracking-[0.2em] text-theme-text font-bold mb-3">◆ {pt.how.flow_title}</h2>
      <p class="font-sans text-sm text-theme-muted max-w-2xl mb-5">{pt.how.flow_intro}</p>
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4">
        {pt.how.flow_steps.map((step, i) => (
          <div class="bg-theme-surface rounded shadow-sm px-5 py-4 border-t-4 border-theme-accent">
            <div class="font-mono text-[10px] text-theme-muted mb-1">{String(i + 1).padStart(2, '0')}</div>
            <div class="font-mono text-sm text-theme-accent font-bold tracking-wider">{step.name}</div>
            <div class="font-mono text-[10px] text-theme-muted tracking-wider mb-2">{step.role}</div>
            <p class="font-sans text-xs text-theme-muted leading-relaxed">{step.text}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Governance spine -->
    <div class="mb-12">
      <h2 class="font-display text-xs tracking-[0.2em] text-theme-text font-bold mb-3">◆ {pt.how.spine_title}</h2>
      <p class="font-sans text-sm text-theme-muted max-w-2xl mb-5">{pt.how.spine_intro}</p>
      <div class="bg-theme-terminal rounded px-5 py-4 space-y-3">
        {pt.how.spine_items.map((item) => (
          <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4">
            <div class="font-mono text-xs text-theme-accent font-bold tracking-wider shrink-0 sm:w-24">{item.name}</div>
            <p class="font-mono text-xs text-theme-muted leading-relaxed">{item.text}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- System Architecture -->
    <div class="mb-12">
      <h2 class="font-display text-xs tracking-[0.2em] text-theme-text font-bold mb-6">◆ ARQUITETURA_DO_SISTEMA</h2>
      <SchematicDiagram />
    </div>

    <!-- Architecture -->
    <div class="mb-8">
      <h2 class="font-display text-xs tracking-[0.2em] text-theme-text font-bold mb-6">◆ {pt.how.architecture_title}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        {pt.how.planets.map((planet) => (
          <PlanetCard
            title={planet.title}
            name={planet.name}
            status={planet.status}
            icon={planet.icon}
            variant={planet.variant}
          >
            <div class="px-4 pb-4">
              <p class="text-xs text-theme-muted font-sans leading-relaxed">{planet.description}</p>
            </div>
          </PlanetCard>
        ))}
      </div>

      <!-- Nota de execução autônoma -->
      <div class="mt-6 bg-theme-surface rounded shadow-sm px-5 py-4">
        <div class="font-mono text-sm text-theme-accent font-bold tracking-wider mb-1">{execTag}</div>
        <p class="font-mono text-xs text-theme-muted leading-relaxed">{execBody}</p>
      </div>
    </div>
  </section>
</BaseLayout>
