---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuaranteeCard from '../../components/GuaranteeCard.astro';
import pt from '../../i18n/pt.json';
---
<BaseLayout title="Solar Systems AI — Princípios" lang="pt" currentPage="principles">
  <section class="max-w-5xl mx-auto">
    <!-- Headline -->
    <div class="mb-10">
      <h1 class="font-display text-2xl font-bold tracking-widest text-theme-accent mb-2">◇ {pt.principles.headline}</h1>
      <p class="font-sans text-sm text-theme-muted">{pt.principles.subtitle}</p>
    </div>

    <!-- Guarantee Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {pt.principles.guarantees.map((g) => (
        <GuaranteeCard
          title={g.title}
          tagline={g.tagline}
          description={g.description}
          variant={g.variant}
        />
      ))}
    </div>
  </section>
</BaseLayout>
