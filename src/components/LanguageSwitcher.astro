---
/* LanguageSwitcher — Toggle between EN and PT locales */
interface Props {
  lang: string;
  currentPath?: string;
}
const { lang, currentPath } = Astro.props;
const otherLang = lang === 'en' ? 'pt' : 'en';
const basePath = currentPath || Astro.url.pathname;
const switchPath = basePath.replace(`/${lang}/`, `/${otherLang}/`);
---
<div class="flex items-center gap-1 font-mono text-[10px] tracking-wider">
  <a
    href={lang === 'en' ? basePath : switchPath}
    class:list={[
      'px-1.5 py-0.5 transition-colors duration-150',
      lang === 'en'
        ? 'text-theme-accent font-bold'
        : 'text-theme-muted hover:text-theme-nav-text',
    ]}
  >
    EN
  </a>
  <span class="text-theme-border">|</span>
  <a
    href={lang === 'pt' ? basePath : switchPath}
    class:list={[
      'px-1.5 py-0.5 transition-colors duration-150',
      lang === 'pt'
        ? 'text-theme-accent font-bold'
        : 'text-theme-muted hover:text-theme-nav-text',
    ]}
  >
    PT
  </a>
</div>
