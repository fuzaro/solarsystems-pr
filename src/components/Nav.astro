---
/* Nav — Top navigation bar with logo, links, and language switcher */
import en from '../i18n/en.json';
import pt from '../i18n/pt.json';

interface Props {
  lang?: string;
  currentPage?: string;
}
const { lang = 'en', currentPage = '' } = Astro.props;
const t = lang === 'pt' ? pt : en;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;

const links = [
  { href: `${base}/${lang}/`, label: t.nav.home, id: 'home' },
  { href: `${base}/${lang}/why`, label: t.nav.why, id: 'why' },
  { href: `${base}/${lang}/how`, label: t.nav.how, id: 'how' },
  { href: `${base}/${lang}/principles`, label: t.nav.principles, id: 'principles' },
  { href: `${base}/${lang}/usecases`, label: t.nav.usecases, id: 'usecases' },
  { href: `${base}/${lang}/status`, label: t.nav.status, id: 'status' },
  { href: `${base}/${lang}/about`, label: t.nav.about, id: 'about' },
];
---
<nav class="bg-theme-nav text-theme-nav-text font-mono">
  <div class="flex items-center justify-between px-6 py-3">
    <!-- Logo -->
    <a href={`${base}/${lang}/`} class="flex items-center gap-3 group">
      <div class="w-8 h-8 bg-theme-accent rounded flex items-center justify-center text-xs font-bold group-hover:opacity-90 transition-opacity">
        SS
      </div>
      <span class="text-sm tracking-[0.3em] font-bold">SOLAR SYSTEMS AI</span>
    </a>

    <!-- Desktop nav links -->
    <div class="hidden lg:flex items-center gap-0.5">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            'px-2.5 py-2 text-[11px] tracking-wider transition-colors duration-150 whitespace-nowrap',
            currentPage === link.id
              ? 'text-theme-accent-2 border-b-2 border-theme-accent-2'
              : 'text-theme-muted hover:text-theme-nav-text',
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- Right side: theme switcher + language switcher + mobile hamburger -->
    <div class="flex items-center gap-4">
      <slot name="theme-switcher" />
      <slot name="lang-switcher" />
      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden text-theme-muted hover:text-theme-nav-text transition-colors"
        aria-label="Toggle menu"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile dropdown -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-theme-border">
    <div class="px-4 py-2 space-y-1">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            'block px-3 py-2 text-xs tracking-wider transition-colors duration-150',
            currentPage === link.id
              ? 'text-theme-accent-2 bg-theme-terminal'
              : 'text-theme-muted hover:text-theme-nav-text hover:bg-theme-terminal',
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
