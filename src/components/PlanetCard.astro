---
/* PlanetCard — Displays a planet/service node with colored header and status */
interface Props {
  title: string;
  name: string;
  status?: string;
  icon?: string;
  variant?: 'orange' | 'blue' | 'gold' | 'green';
}
const { title, name, status = 'OPTIMIZED', icon = '◆', variant = 'blue' } = Astro.props;

const variantClasses: Record<string, string> = {
  orange: 'bg-theme-card-1',
  blue: 'bg-theme-card-2',
  gold: 'bg-theme-card-3',
  green: 'bg-theme-success',
};
---
<div class="bg-theme-surface rounded shadow-sm card-hover overflow-hidden font-mono">
  <!-- Colored header bar -->
  <div class:list={[variantClasses[variant], 'px-4 py-2 flex items-center justify-between']}>
    <span class="text-theme-nav-text text-xs tracking-[0.2em] font-bold">{title}</span>
    <span class="text-theme-nav-text/70 text-sm">{icon}</span>
  </div>
  <!-- Body -->
  <div class="px-4 py-5 text-center">
    <div class="text-3xl mb-3 text-theme-text">{icon}</div>
    <div class="text-sm tracking-[0.15em] text-theme-text font-bold mb-2">{name}</div>
    <div class="text-[10px] tracking-wider text-theme-muted">
      STATUS: <span class="text-theme-success">{status}</span>
    </div>
  </div>
  <slot />
</div>
